{
  "name": "claude-remote-box-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Status dashboard for claude-remote-box: one card per box, fed by the boxes' status reports.",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "node server/index.js",
    "dev": "concurrently -k \"node server/index.js\" \"vite --config web/vite.config.ts\"",
    "build": "vite build --config web/vite.config.ts",
    "typecheck": "tsc -p web/tsconfig.json --noEmit",
    "test": "node --test test/",
    "seed": "node seed.mjs"
  },
  "devDependencies": {
    "@radix-ui/react-collapsible": "1.2.1",
    "@radix-ui/react-progress": "1.2.1",
    "@radix-ui/react-slot": "1.5.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "concurrently": "10.0.6",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  }
}
