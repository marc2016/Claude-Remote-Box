{
  "name": "claude-remote-box-dashboard",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Status dashboard for claude-remote-box: one card per box, fed by the boxes' status reports.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "CRB_STATUS_TOKEN=dev CRB_DASHBOARD_AUTH=off DATA_DIR=.data HOST=127.0.0.1 concurrently -k -n server,vite,seed -c blue,magenta,green \"node server/index.js\" \"vite --config web/vite.config.ts\" \"node seed.mjs\"",
    "build": "vite build --config web/vite.config.ts",
    "typecheck": "tsc -p web/tsconfig.json --noEmit",
    "test": "node --test test/",
    "seed": "CRB_STATUS_TOKEN=${CRB_STATUS_TOKEN:-dev} node seed.mjs",
    "demo": "node demo.mjs"
  },
  "devDependencies": {
    "@radix-ui/react-collapsible": "1.2.1",
    "@radix-ui/react-progress": "1.2.1",
    "@radix-ui/react-slot": "1.5.0",
    "@shadcn/react": "0.3.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "0.5.2",
    "concurrently": "10.0.6",
    "lucide-react": "1.70.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "streamdown": "2.7.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  },
  "dependencies": {
    "@simplewebauthn/server": "14.1.0"
  }
}
