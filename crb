cmd_dashboard() {
  case "${1-}" in
    "") ;;
    login) cmd_dashboard_login; return ;;
    logout) cmd_dashboard_logout; return ;;
    reset) cmd_dashboard_reset; return ;;
    *) usage >&2; exit 64 ;;
  esac
  banner "Dashboard hinzufügen"
  check_host
  [ -f compose.yaml ] || die "Hier liegt keine compose.yaml. Bitte im Ordner der Installation ausführen."
  local service_file=$DASHBOARD_FILE
  if [ -f "$service_file" ]; then
    echo "   $service_file ist schon vorhanden, nichts zu tun."
    echo "   Boxen anbinden oder prüfen: ./crb update"
    exit 0
  fi
  if [ ! -f box.yaml ] || [ ! -d services ]; then
    echo "   Einzeldatei-Setup (Services in compose.yaml): Dateien werden nicht bearbeitet."
    echo "   Von Hand eintragen:"
    echo "     1) .env:  CRB_STATUS_TOKEN=<zufälliger Wert>"
    echo "     2) jeder Box unter environment:"
    echo "          CRB_STATUS_URL: \"http://crb-dashboard:8080/api/ingest\""
    echo "          CRB_STATUS_TOKEN: \"\${CRB_STATUS_TOKEN}\""
    echo "     3) ein Service crb-dashboard wie in compose.example.yaml (Image $CRB_DASHBOARD_IMAGE)"
    exit 0
  fi
  if ! grep -qE '^include:[[:space:]]*$' compose.yaml; then
    die "compose.yaml: 'include:' muss allein in seiner Zeile stehen, mit den Einträgen als Liste darunter."
  fi

  local token_state="vorhanden" missing_status
  if ! { [ -f .env ] && grep -qE '^CRB_STATUS_TOKEN=.+' .env; }; then token_state="wird erzeugt"; fi
  missing_status=$(status_lines_missing | tr '\n' ' ')
  local -a boxes=()
  local f
  for f in services/*.yaml; do
    [ -f "$f" ] || continue
    boxes+=("$(basename "$f" .yaml)")
  done

  echo ""
  echo "📋 Zusammenfassung"
  echo "  Dashboard:    $service_file (Image $CRB_DASHBOARD_IMAGE)"
  echo "  Port:         \${CRB_DASHBOARD_BIND:-127.0.0.1:8080} -> 8080 (in .env änderbar)"
  echo "  Login:        Passkeys; der erste wird danach mit ./crb dashboard login angelegt"
  echo "  Token:        CRB_STATUS_TOKEN in .env ($token_state)"
  if [ -n "$missing_status" ]; then
    echo "  box.yaml:     $missing_status"
  else
    echo "  box.yaml:     Status-Variablen schon vorhanden"
  fi
  echo "  Boxen:        ${boxes[*]:-keine} (melden sich nach dem Neustart)"
  echo ""
  if ! confirm "Anlegen?"; then
    echo "Abgebrochen, nichts geändert."
    exit 0
  fi

  # --- Changes (restorable) --------------------------------------------------
  local backup
  backup=$(mktemp -d)
  cp -p compose.yaml "$backup/compose.yaml"
  cp -p box.yaml "$backup/box.yaml"
  [ -f .env ] && cp -p .env "$backup/.env"

  echo ""
  echo "✍️  1/2 Schreibe Dateien..."
  ensure_status_token
  add_status_lines
  cat > "$service_file" <<EOF
# Created by crb. The status dashboard: one card per box, fed by the boxes'
# status reports. Login with passkeys: ./crb dashboard login. The CRB_DASHBOARD_*
# values come from .env, see README, "Status dashboard".
services:
  crb-dashboard:
    image: ${CRB_DASHBOARD_IMAGE}
    restart: unless-stopped
    user: "\${UID:-1000}:\${GID:-1000}"
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true]
    environment:
      CRB_STATUS_TOKEN: "\${CRB_STATUS_TOKEN}"
      CRB_DASHBOARD_URL: "\${CRB_DASHBOARD_URL:-}"
      CRB_DASHBOARD_PROXY: "\${CRB_DASHBOARD_PROXY:-}"
      CRB_DASHBOARD_AUTH: "\${CRB_DASHBOARD_AUTH:-}"
      CRB_DASHBOARD_REMOTE_INGEST: "\${CRB_DASHBOARD_REMOTE_INGEST:-}"
    ports:
      - "\${CRB_DASHBOARD_BIND:-127.0.0.1:8080}:8080"
    volumes:
      - "crb-dashboard-data:/data"

volumes:
  crb-dashboard-data: {}
EOF
  local tmp
  tmp=$(mktemp)
  awk -v line="  - $service_file" '{ print } !done && /^include:[[:space:]]*$/ { print line; done = 1 }' compose.yaml > "$tmp"
  cat "$tmp" > compose.yaml
  rm -f "$tmp"

  echo ""
  echo "🔍 2/2 Prüfe mit docker compose config..."
  local check
  if ! check=$(docker compose config -q 2>&1); then
    echo "$check" >&2
    rm -f "$service_file"
    cp -p "$backup/compose.yaml" compose.yaml
    cp -p "$backup/box.yaml" box.yaml
    if [ -f "$backup/.env" ]; then cp -p "$backup/.env" .env; else rm -f .env; fi
    rm -rf "$backup"
    die "Die Compose-Konfiguration ist ungültig. Alle Änderungen wurden zurückgenommen."
  fi
  rm -rf "$backup"

  echo ""
  echo "✨ Dashboard ist angelegt. Weiter mit:"
  echo "   docker compose up -d        (startet das Dashboard und bindet die Boxen an)"
  echo "   ./crb dashboard login       (legt den ersten Passkey an; bis dahin ist die Seite gesperrt)"
  echo "   Der Port liegt auf 127.0.0.1:8080 (CRB_DASHBOARD_BIND in .env); für die Anmeldung"
  echo "   braucht das Dashboard eine https-Adresse über einen Reverse Proxy, siehe README."
}

# =============================================================================
# git
# =============================================================================

# gq: every Git call of `crb git`. No automatic housekeeping: it would prune
# the records of worktrees created inside the container, whose recorded paths
# (/workspace/...) do not exist on the host.
gq() { git -c gc.auto=0 "$@" </dev/null; }

# service_workspace FILE: source of the /workspace mount as written, or empty.
service_workspace() {
  sed -n -E 's|^[[:space:]]*-[[:space:]]*["'"'"']?([^"'"'"':]+):/workspace(:[a-z,]+)?["'"'"']?[[:space:]]*(#.*)?$|\1|p' "$1" | head -n 1
}

# git_line MARK BRANCH TEXT: one branch line, at most 40 columns for names up
# to 20 characters.
git_line() {
  local mark=$1 n=$2 text=$3 pad
  if [ ${#n} -gt 20 ]; then n="${n:0:19}…"; fi
  pad=$((20 - ${#n}))
  printf '%s %s%*s %s\n' "$mark" "$n" "$pad" "" "$text"
}

# git_note TEXT...: lines below a branch or project line, folded for a phone.
git_note() { printf '%s\n' "$@" | head -n 4 | fold -s -w 36 | sed 's/^/    /'; }

# Field separator of a branch row. It cannot occur in a ref name or a path
# and, not being whitespace, keeps empty fields when a row is split.
US=$'\037'

# git_scan SRC FETCH: reads one project into GS_*. Prints nothing and changes
# nothing except the fetch (FETCH=1).
#   GS_STATUS  ok | fetch-failed | no-repo | no-origin | volume | missing | unsupported
#   GS_MSG     Git's message for a failed fetch, the path for a missing directory
#   GS_WS      the workspace on the host
#   GS_ROWS    one row per local branch, the workspace's own branch first:
#              branch, kind, ahead, behind, checked out, admin dir, host path,
#              dirty, remote counterpart
# Kinds: equal, empty (new, no commits), ff, push, pushnew, diverged, gone,
# blocked (behind, modified tracked files), unreachable (behind, checkout not
# on the host).
git_scan() {
  local src=${1//\$\$/\$} fetch=$2 ws=""
  GS_STATUS=ok; GS_MSG=""; GS_WS=""; GS_ROWS=()
  case "$src" in
    /*) ws=$src ;;
    \~/*) ws="$HOME/${src#\~/}" ;;
    */*|.*) ws="services/$src" ;;
    *) GS_STATUS=volume; return 0 ;;
  esac
  if ! ws=$(cd "$ws" 2>/dev/null && pwd); then GS_STATUS=missing; GS_MSG=$src; return 0; fi
  if [ -f "$ws/.git" ]; then GS_STATUS=unsupported; return 0; fi
  if [ ! -d "$ws/.git" ]; then GS_STATUS=no-repo; return 0; fi
  if ! gq -C "$ws" remote get-url origin >/dev/null 2>&1; then GS_STATUS=no-origin; return 0; fi
  GS_WS=$ws

  local err=""
  if [ "$fetch" -eq 1 ] && ! err=$(gq -C "$ws" fetch --prune --quiet origin 2>&1); then
    GS_STATUS="fetch-failed"; GS_MSG=$err
  fi

  # Checkouts as "branch<TAB>admin dir<TAB>host path"; the path is empty when
  # the worktree cannot be reached from the host. Worktrees are addressed by
  # their administrative directory, so records with container paths work and
  # stay untouched.
  local tab=$'\t' nl=$'\n' co="" first="" b="" d="" rec="" host=""
  first=$(gq -C "$ws" symbolic-ref -q --short HEAD || true)
  if [ -n "$first" ]; then co="$first$tab$ws/.git$tab$ws$nl"; fi
  for d in "$ws"/.git/worktrees/*/; do
    d=${d%/}
    [ -f "$d/gitdir" ] || continue
    b=$(gq --git-dir="$d" symbolic-ref -q --short HEAD || true)
    [ -n "$b" ] || continue
    rec=$(cat "$d/gitdir"); rec=${rec%/.git}
    case "$rec" in
      /workspace/*) host="$ws/${rec#/workspace/}" ;;
      /*) host=$rec ;;
      *) host=$(cd "$d" 2>/dev/null && cd "$rec" 2>/dev/null && pwd) || host="" ;;
    esac
    if [ -z "$host" ] || [ ! -d "$host" ]; then host=""; fi
    co="$co$b$tab$d$tab$host$nl"
  done

  local def="" c=""
  def=$(gq -C "$ws" symbolic-ref -q --short refs/remotes/origin/HEAD || true)
  if [ -z "$def" ]; then
    for c in origin/main origin/master; do
      if gq -C "$ws" show-ref --verify -q "refs/remotes/$c"; then def=$c; break; fi
    done
  fi

  # The branch checked out in the workspace first, the others by name.
  # ":" cannot occur in a ref name.
  local refs="" line=""
  refs=$(gq -C "$ws" for-each-ref refs/heads --format='%(refname:short):%(upstream:remotename):%(upstream:short):%(upstream:track)')
  refs=$(printf '%s\n' "$refs" | awk -F: -v f="$first" '$1 == f'; printf '%s\n' "$refs" | awk -F: -v f="$first" '$1 != f')

  local re_a='ahead ([0-9]+)' re_b='behind ([0-9]+)'
  local up_remote="" up="" track="" target="" state="" ahead=0 behind=0 counts=""
  local row="" checked=0 admin="" path="" dirty=0 kind=""
  while IFS= read -r line <&3; do
    [ -n "$line" ] || continue
    IFS=: read -r b up_remote up track <<<"$line"

    # State against the remote counterpart: the configured upstream on origin,
    # else origin/<branch> when it exists.
    target=""; state=ok; ahead=0; behind=0
    if [ -n "$up" ] && [ "$up_remote" = origin ]; then
      target=$up
      if [ "$track" = "[gone]" ]; then
        state=gone
      else
        if [[ "$track" =~ $re_a ]]; then ahead=${BASH_REMATCH[1]}; fi
        if [[ "$track" =~ $re_b ]]; then behind=${BASH_REMATCH[1]}; fi
      fi
    elif gq -C "$ws" show-ref --verify -q "refs/remotes/origin/$b"; then
      target="origin/$b"
      counts=$(gq -C "$ws" rev-list --left-right --count "refs/heads/$b...refs/remotes/origin/$b")
      ahead=${counts%%[[:space:]]*}; behind=${counts##*[[:space:]]}
    else
      state=none
      if [ -n "$def" ]; then
        ahead=$(gq -C "$ws" rev-list --count "refs/remotes/$def..refs/heads/$b")
      else
        ahead=$(gq -C "$ws" rev-list --count "refs/heads/$b")
      fi
    fi

    row=$(printf '%s' "$co" | awk -F'\t' -v b="$b" '$1 == b { print; exit }')
    checked=0; admin=""; path=""; dirty=0
    if [ -n "$row" ]; then
      checked=1
      admin=$(printf '%s\n' "$row" | cut -f2); path=$(printf '%s\n' "$row" | cut -f3)
      if [ -n "$path" ] && [ -n "$(gq --git-dir="$admin" --work-tree="$path" status --porcelain --untracked-files=no 2>/dev/null)" ]; then dirty=1; fi
    fi

    if [ "$state" = gone ]; then kind=gone
    elif [ "$state" = none ]; then if [ "$ahead" -gt 0 ]; then kind=pushnew; else kind=empty; fi
    elif [ "$ahead" -gt 0 ] && [ "$behind" -gt 0 ]; then kind=diverged
    elif [ "$ahead" -gt 0 ]; then kind=push
    elif [ "$behind" -eq 0 ]; then kind=equal
    elif [ "$checked" -eq 1 ] && [ -z "$path" ]; then kind=unreachable
    elif [ "$dirty" -eq 1 ]; then kind=blocked
    else kind=ff
    fi
    GS_ROWS+=("$b$US$kind$US$ahead$US$behind$US$checked$US$admin$US$path$US$dirty$US$target")
  done 3<<REFS
$refs
REFS
  return 0
}

# git_row ROW: splits a row into R_* and adds what to show for it: R_MARK
# (↓ fast-forward, ↑ push, ! left for the user, = nothing), R_TEXT, R_STAR
# (local changes in the checkout), R_NOTE (why it is left for the user).
git_row() {
  IFS=$US read -r R_B R_KIND R_AHEAD R_BEHIND R_CHECKED R_ADMIN R_PATH R_DIRTY R_TARGET <<<"$1"
  R_STAR=""; R_NOTE=""
  if [ "$R_DIRTY" -eq 1 ] && [ "$R_KIND" != blocked ] && [ "$R_KIND" != diverged ]; then R_STAR=" *"; fi
  case "$R_KIND" in
    equal) R_MARK="="; R_TEXT="aktuell" ;;
    empty) R_MARK="="; R_TEXT="neu, leer" ;;
    ff) R_MARK="↓"; R_TEXT="$R_BEHIND hinter" ;;
    push) R_MARK="↑"; R_TEXT="$R_AHEAD vor" ;;
    pushnew) R_MARK="↑"; if [ "$R_AHEAD" -eq 1 ]; then R_TEXT="neu, 1 Commit"; else R_TEXT="neu, $R_AHEAD Commits"; fi ;;
    gone) R_MARK="!"; R_TEXT="Upstream fehlt"; R_NOTE="auf origin gelöscht" ;;
    diverged)
      R_MARK="!"; R_TEXT="$R_AHEAD vor $R_BEHIND hinter"
      if [ "$R_DIRTY" -eq 1 ]; then R_NOTE="divergiert, lokale Änderungen"; else R_NOTE="divergiert, bitte selbst lösen"; fi ;;
    blocked) R_MARK="!"; R_TEXT="$R_BEHIND hinter"; R_NOTE="lokale Änderungen, kein Pull" ;;
    *) R_MARK="!"; R_TEXT="$R_BEHIND hinter"; R_NOTE="Checkout vom Host nicht erreichbar" ;;
  esac
}

# git_apply: the one action the row in R_* allows (kinds ff, push, pushnew),
# in the workspace GS_WS. Sets GA_TEXT (result, or the state when it failed)
# and GA_ERR (Git's message); returns non-zero when it failed.
git_apply() {
  local old="" new=""
  GA_ERR=""
  case "$R_KIND" in
    ff)
      GA_TEXT="$R_BEHIND hinter"
      if [ "$R_CHECKED" -eq 1 ]; then
        # Checked out: move the branch and its files, fast-forward only.
        if ! GA_ERR=$(gq --git-dir="$R_ADMIN" --work-tree="$R_PATH" merge --ff-only --quiet "refs/remotes/$R_TARGET" 2>&1); then return 1; fi
      else
        # Not checked out: move the ref, guarded by its old value.
        old=$(gq -C "$GS_WS" rev-parse "refs/heads/$R_B"); new=$(gq -C "$GS_WS" rev-parse "refs/remotes/$R_TARGET")
        if ! GA_ERR=$(gq -C "$GS_WS" update-ref -m "crb git sync: fast-forward" "refs/heads/$R_B" "$new" "$old" 2>&1); then return 1; fi
      fi
      GA_TEXT="$R_BEHIND geholt" ;;
    push)
      GA_TEXT="$R_AHEAD vor"
      if ! GA_ERR=$(gq -C "$GS_WS" push --quiet origin "refs/heads/$R_B:refs/heads/${R_TARGET#origin/}" 2>&1); then GA_ERR=${GA_ERR:-push fehlgeschlagen}; return 1; fi
      GA_TEXT="$R_AHEAD gepusht" ;;
    pushnew)
      GA_TEXT="$R_AHEAD vor"
      if ! GA_ERR=$(gq -C "$GS_WS" push --quiet -u origin "refs/heads/$R_B:refs/heads/$R_B" 2>&1); then GA_ERR=${GA_ERR:-push fehlgeschlagen}; return 1; fi
      GA_TEXT="neu, $R_AHEAD gepusht" ;;
    *) GA_TEXT=""; GA_ERR="keine Aktion für diesen Zustand"; return 1 ;;
  esac
  GA_ERR=""
  return 0
}

# git_status_text: why the scanned project cannot be handled, or empty.
git_status_text() {
  case "$GS_STATUS" in
    volume) echo "Docker-Volume, kein Ordner" ;;
    missing) echo "Ordner fehlt" ;;
    unsupported) echo "nicht unterstützt" ;;
    no-repo) echo "kein Git-Repository" ;;
    no-origin) echo "kein Remote origin" ;;
    fetch-failed) echo "Fetch fehlgeschlagen" ;;
  esac
}

# git_report NAME FETCHED: prints the scanned project as the overview, or, with
# GIT_MODE=sync, applies the sync rule and prints the results. Updates the
# GIT_N_* counters of cmd_git.
git_report() {
  local name=$1 fetched=$2 row=""
  case "$GS_STATUS" in
    ok) if [ "$fetched" -eq 1 ]; then echo "$name · Fetch ok"; else echo "$name · ohne Fetch"; fi ;;
    fetch-failed)
      GIT_N_FAIL=$((GIT_N_FAIL + 1))
      echo "$name · Fetch fehlgeschlagen"
      git_note "$GS_MSG"
      # Acting on refs of unknown age could push over or pull less than what is on origin.
      if [ "$GIT_MODE" = sync ]; then git_note "Nichts geändert."; return 0; fi
      git_note "Stand evtl. veraltet:" ;;
    missing) echo "$name · Ordner fehlt"; git_note "$GS_MSG"; return 0 ;;
    unsupported) echo "$name · nicht unterstützt"; git_note "Das Git-Verzeichnis liegt außerhalb des Workspace."; return 0 ;;
    *) echo "$name · $(git_status_text)"; return 0 ;;
  esac
  [ ${#GS_ROWS[@]} -gt 0 ] || return 0
  for row in "${GS_ROWS[@]}"; do
    git_row "$row"
    if [ -n "$R_STAR" ]; then GIT_STAR=1; fi
    case "$R_KIND" in
      equal|empty) git_line "$R_MARK" "$R_B" "$R_TEXT$R_STAR" ;;
      ff|push|pushnew)
        if [ "$GIT_MODE" != sync ]; then
          GIT_N_PLAN=$((GIT_N_PLAN + 1)); git_line "$R_MARK" "$R_B" "$R_TEXT$R_STAR"
        elif git_apply; then
          if [ "$R_KIND" = ff ]; then GIT_N_FF=$((GIT_N_FF + 1)); else GIT_N_PUSH=$((GIT_N_PUSH + 1)); fi
          git_line "✓" "$R_B" "$GA_TEXT$R_STAR"
        else
          GIT_N_FAIL=$((GIT_N_FAIL + 1)); git_line "✗" "$R_B" "$GA_TEXT"; git_note "$GA_ERR"
        fi ;;
      *) GIT_N_OPEN=$((GIT_N_OPEN + 1)); git_line "$R_MARK" "$R_B" "$R_TEXT$R_STAR"; git_note "$R_NOTE" ;;
    esac
  done
  return 0
}

# --- menu ----------------------------------------------------------------------
# Three screens: projects, the branches of one project, the actions for one
# branch. Choices are numbers and single letters; nothing is cleared, so the
# scrollback keeps the history. Screen functions return 0 for "back" and 2
# for "end"; call them with `|| rc=$?`.

# menu_read: reads one choice into CHOICE; fails at the end of the input.
menu_read() {
  printf 'Auswahl: '
  if ! IFS= read -r CHOICE; then echo ""; return 1; fi
  if [ ! -t 0 ]; then echo "$CHOICE"; fi
  CHOICE=${CHOICE#"${CHOICE%%[![:space:]]*}"}; CHOICE=${CHOICE%"${CHOICE##*[![:space:]]}"}
  return 0
}

menu_bad() { echo "'$1' steht nicht zur Auswahl."; }

# menu_confirm "Question": yes only for y/Y, default no. Unlike confirm, the
# question is also printed when the input is not a terminal.
menu_confirm() {
  local a=""
  printf '%s (y/N): ' "$1"
  if ! IFS= read -r a; then echo ""; return 1; fi
  if [ ! -t 0 ]; then echo "$a"; fi
  [[ "$a" =~ ^[Yy]$ ]]
}

# menu_line NUMBER MARK BRANCH TEXT: at most 40 columns for names up to 18.
menu_line() {
  local n=$3 pad
  if [ ${#n} -gt 18 ]; then n="${n:0:17}…"; fi
  pad=$((18 - ${#n}))
  printf '%2s %s %s%*s %s\n' "$1" "$2" "$n" "$pad" "" "$4"
}

# menu_summary: one-line summary of the scanned project.
menu_summary() {
  local row="" push=0 ff=0 open=0 s=""
  if [ "$GS_STATUS" != ok ]; then git_status_text; return 0; fi
  if [ ${#GS_ROWS[@]} -gt 0 ]; then
    for row in "${GS_ROWS[@]}"; do
      git_row "$row"
      case "$R_KIND" in
        push|pushnew) push=$((push + 1)) ;;
        ff) ff=$((ff + 1)) ;;
        equal|empty) ;;
        *) open=$((open + 1)) ;;
      esac
    done
  fi
  if [ "$push" -gt 0 ]; then s="$s ↑$push"; fi
  if [ "$ff" -gt 0 ]; then s="$s ↓$ff"; fi
  if [ "$open" -gt 0 ]; then s="$s !$open"; fi
  echo "${s:- aktuell}" | cut -c2-
}

# menu_scan I FETCH: scans project I and stores its summary. A failed fetch is
# remembered until the next fetch, because later scans do not fetch.
menu_scan() {
  local i=$1 fetch=$2
  git_scan "${GM_SRCS[$i]}" "$fetch"
  if [ "$fetch" -eq 1 ]; then
    if [ "$GS_STATUS" = fetch-failed ]; then GM_FAILED[i]=1; GM_MSGS[i]=$GS_MSG; else GM_FAILED[i]=0; GM_MSGS[i]=""; fi
  elif [ "$GS_STATUS" = ok ] && [ "${GM_FAILED[$i]}" -eq 1 ]; then
    GS_STATUS="fetch-failed"; GS_MSG=${GM_MSGS[i]}
  fi
  GM_SUMS[i]=$(menu_summary)
}

menu_fetch_all() {
  local i
  for i in "${!GM_NAMES[@]}"; do
    echo "Abrufen: ${GM_NAMES[$i]}"
    menu_scan "$i" "$1"
  done
}

# menu_sync_scanned NAME: applies the sync rule to the scanned project and
# prints one line per branch that was handled. Adds to MS_PUSH, MS_FF, MS_FAIL.
menu_sync_scanned() {
  local row=""
  [ "$GS_STATUS" = ok ] || return 0
  [ ${#GS_ROWS[@]} -gt 0 ] || return 0
  for row in "${GS_ROWS[@]}"; do
    git_row "$row"
    case "$R_KIND" in
      ff|push|pushnew)
        if git_apply; then
          if [ "$R_KIND" = ff ]; then MS_FF=$((MS_FF + 1)); else MS_PUSH=$((MS_PUSH + 1)); fi
          menu_line "" "✓" "$R_B" "$GA_TEXT$R_STAR"
        else
          MS_FAIL=$((MS_FAIL + 1)); menu_line "" "✗" "$R_B" "$GA_TEXT"; git_note "$GA_ERR"
        fi ;;
    esac
  done
  return 0
}

# menu_plan: adds the scanned project's branches to push and to fetch to
# MP_PUSH and MP_FF.
menu_plan() {
  local row=""
  [ "$GS_STATUS" = ok ] || return 0
  [ ${#GS_ROWS[@]} -gt 0 ] || return 0
  for row in "${GS_ROWS[@]}"; do
    git_row "$row"
    case "$R_KIND" in
      push|pushnew) MP_PUSH=$((MP_PUSH + 1)) ;;
      ff) MP_FF=$((MP_FF + 1)) ;;
    esac
  done
  return 0
}

# menu_sync FIRST LAST: synchronizes the projects FIRST..LAST after showing
# what will happen and a confirmation.
menu_sync() {
  local i open=0 sum=""
  MP_PUSH=0; MP_FF=0
  for ((i = $1; i <= $2; i++)); do menu_scan "$i" 0; menu_plan; done
  if [ "$MP_PUSH" -eq 0 ] && [ "$MP_FF" -eq 0 ]; then echo "Nichts zu pushen oder zu holen."; return 0; fi
  if ! menu_confirm "$MP_PUSH pushen, $MP_FF holen. Ausführen?"; then echo "Nichts geändert."; return 0; fi
  MS_PUSH=0; MS_FF=0; MS_FAIL=0
  for ((i = $1; i <= $2; i++)); do
    menu_scan "$i" 0
    if [ "$1" -ne "$2" ] && [ "$GS_STATUS" = ok ]; then echo "${GM_NAMES[$i]}"; fi
    menu_sync_scanned
    menu_scan "$i" 0
    case "${GM_SUMS[$i]}" in *"!"*) open=$((open + $(echo "${GM_SUMS[$i]}" | sed -E 's/.*!([0-9]+).*/\1/'))) ;; esac
  done
  sum="$MS_PUSH gepusht · $MS_FF geholt · $open offen"
  if [ "$MS_FAIL" -gt 0 ]; then sum="$sum · $MS_FAIL Fehler"; fi
  echo "$sum"
}

# menu_cut: cuts lines to the screen width and indents them.
menu_cut() { cut -c1-36 | sed 's/^/  /'; }

# menu_resolve HOW: rebase or merge for the diverged row in R_*, after a
# confirmation. A conflict or any other failure is aborted, so the branch and
# its files are as before.
menu_resolve() {
  local how=$1 old="" now="" files="" err=""
  local -a g=(--git-dir="$R_ADMIN" --work-tree="$R_PATH")
  if [ "$how" = rebase ]; then
    echo "Rebase: $R_AHEAD lokal auf $R_TARGET ($R_BEHIND neu)."
  else
    echo "Merge: $R_TARGET ($R_BEHIND neu) in $R_B."
  fi
  echo "Checkout: $R_PATH"
  echo "Eine Session dort sieht danach"
  echo "geänderte Dateien. Gepusht wird nicht."
  if ! menu_confirm "Ausführen?"; then echo "Nichts geändert."; return 0; fi
  old=$(gq "${g[@]}" rev-parse HEAD)
  if [ "$how" = rebase ]; then
    if err=$(gq "${g[@]}" rebase "refs/remotes/$R_TARGET" 2>&1); then echo "✓ Rebase fertig."; return 0; fi
  else
    if err=$(gq "${g[@]}" merge --no-edit "refs/remotes/$R_TARGET" 2>&1); then echo "✓ Merge fertig."; return 0; fi
  fi
  files=$(gq "${g[@]}" diff --name-only --diff-filter=U 2>/dev/null || true)
  if [ -d "$R_ADMIN/rebase-merge" ] || [ -d "$R_ADMIN/rebase-apply" ]; then gq "${g[@]}" rebase --abort >/dev/null 2>&1 || true; fi
  if [ -f "$R_ADMIN/MERGE_HEAD" ]; then gq "${g[@]}" merge --abort >/dev/null 2>&1 || true; fi
  now=$(gq "${g[@]}" rev-parse HEAD 2>/dev/null || true)
  if [ "$now" != "$old" ] || [ -d "$R_ADMIN/rebase-merge" ] || [ -d "$R_ADMIN/rebase-apply" ] || [ -f "$R_ADMIN/MERGE_HEAD" ]; then
    warn "Abbruch fehlgeschlagen. Bitte im Checkout prüfen:"
    echo "  $R_PATH"
    git_note "$err"
    return 0
  fi
  if [ "$how" = rebase ]; then echo "✗ Rebase abgebrochen, Stand wie vorher."; else echo "✗ Merge abgebrochen, Stand wie vorher."; fi
  if [ -n "$files" ]; then
    echo "Konflikt in:"
    printf '%s\n' "$files" | head -n 10 | menu_cut
  else
    git_note "$err"
  fi
  echo "Bitte von Hand lösen."
}

# menu_branch I BRANCH: the actions for one branch of project I.
menu_branch() {
  local i=$1 want=$2 row="" found=0 n=0 why="" more=0
  local -a acts=()
  while :; do
    menu_scan "$i" 0
    found=0
    if [ "$GS_STATUS" = ok ] && [ ${#GS_ROWS[@]} -gt 0 ]; then
      for row in "${GS_ROWS[@]}"; do git_row "$row"; if [ "$R_B" = "$want" ]; then found=1; break; fi; done
    fi
    if [ "$found" -eq 0 ]; then echo "$want gibt es nicht mehr."; return 0; fi

    echo ""
    echo "${GM_NAMES[$i]} · $R_B"
    # A diverged branch can be resolved here, so its note for the overview does not apply.
    if [ "$R_KIND" = diverged ]; then echo "$R_TEXT · divergiert"; else echo "$R_TEXT$R_STAR${R_NOTE:+ · $R_NOTE}" | fold -s -w 40; fi
    acts=(); n=0
    case "$R_KIND" in
      ff) acts+=(ff); n=$((n + 1)); echo "$(printf '%2s' "$n") holen (fast-forward)" ;;
      push|pushnew) acts+=(push); n=$((n + 1)); echo "$(printf '%2s' "$n") pushen" ;;
      blocked) acts+=(files); n=$((n + 1)); echo "$(printf '%2s' "$n") geänderte Dateien zeigen" ;;
      diverged)
        acts+=(sides); n=$((n + 1)); echo "$(printf '%2s' "$n") Commits beider Seiten zeigen"
        why=""
        if [ "$R_CHECKED" -eq 0 ]; then why="Nicht ausgecheckt: erst auschecken."
        elif [ -z "$R_PATH" ]; then why="Checkout vom Host nicht erreichbar."
        elif [ "$R_DIRTY" -eq 1 ]; then why="Erst committen oder verwerfen."
        elif [ -d "$R_ADMIN/rebase-merge" ] || [ -d "$R_ADMIN/rebase-apply" ] || [ -f "$R_ADMIN/MERGE_HEAD" ]; then why="Dort läuft schon Rebase oder Merge."
        fi
        if [ -z "$why" ]; then
          acts+=(rebase); n=$((n + 1)); echo "$(printf '%2s' "$n") Rebase auf $R_TARGET"
          acts+=(merge); n=$((n + 1)); echo "$(printf '%2s' "$n") Merge von $R_TARGET"
        else
          echo "   $why"
          if [ "$R_DIRTY" -eq 1 ] && [ -n "$R_PATH" ]; then acts+=(files); n=$((n + 1)); echo "$(printf '%2s' "$n") geänderte Dateien zeigen"; fi
        fi ;;
    esac
    acts+=(log); n=$((n + 1)); echo "$(printf '%2s' "$n") letzte Commits zeigen"
    echo " z zurück   q Ende"
    menu_read || return 2
    case "$CHOICE" in
      "") continue ;;
      q) return 2 ;;
      z) return 0 ;;
    esac
    if ! [[ "$CHOICE" =~ ^[0-9]+$ ]] || [ "$CHOICE" -lt 1 ] || [ "$CHOICE" -gt "$n" ]; then menu_bad "$CHOICE"; continue; fi
    case "${acts[$((CHOICE - 1))]}" in
      ff|push)
        if git_apply; then echo "✓ $R_B: $GA_TEXT"; else echo "✗ $R_B: $GA_TEXT"; git_note "$GA_ERR"; fi ;;
      files)
        gq --git-dir="$R_ADMIN" --work-tree="$R_PATH" status --short --untracked-files=no | head -n 15 | menu_cut ;;
      sides)
        echo "lokal:"
        gq -C "$GS_WS" log --oneline --no-decorate -n 10 "refs/remotes/$R_TARGET..refs/heads/$R_B" | menu_cut
        more=$((R_AHEAD - 10)); if [ "$more" -gt 0 ]; then echo "  … und $more weitere"; fi
        echo "auf origin:"
        gq -C "$GS_WS" log --oneline --no-decorate -n 10 "refs/heads/$R_B..refs/remotes/$R_TARGET" | menu_cut
        more=$((R_BEHIND - 10)); if [ "$more" -gt 0 ]; then echo "  … und $more weitere"; fi ;;
      rebase|merge) menu_resolve "${acts[$((CHOICE - 1))]}" ;;
      log) gq -C "$GS_WS" log --oneline --no-decorate -n 5 "refs/heads/$R_B" | menu_cut ;;
    esac
  done
}

# menu_project I: the branches of project I.
menu_project() {
  local i=$1 row="" n=0 rc=0
  local -a branches=()
  while :; do
    menu_scan "$i" 0
    echo ""
    echo "${GM_NAMES[$i]}"
    branches=(); n=0
    case "$GS_STATUS" in
      ok|fetch-failed)
        if [ "$GS_STATUS" = fetch-failed ]; then
          echo "Fetch fehlgeschlagen, Stand evtl. veraltet. Aktionen sind gesperrt."
          git_note "$GS_MSG"
        fi
        if [ ${#GS_ROWS[@]} -gt 0 ]; then
          for row in "${GS_ROWS[@]}"; do
            git_row "$row"
            n=$((n + 1))
            if [ "$GS_STATUS" = ok ]; then branches+=("$R_B"); menu_line "$n" "$R_MARK" "$R_B" "$R_TEXT$R_STAR"
            else menu_line "" "$R_MARK" "$R_B" "$R_TEXT$R_STAR"; fi
          done
        fi
        if [ "$GS_STATUS" = ok ]; then echo " s Projekt synchronisieren"; fi
        echo " f neu abrufen (fetch)" ;;
      *) echo "$(git_status_text)." ;;
    esac
    echo " z zurück   q Ende"
    menu_read || return 2
    case "$CHOICE" in
      "") continue ;;
      q) return 2 ;;
      z) return 0 ;;
      f) case "$GS_STATUS" in ok|fetch-failed) echo "Abrufen: ${GM_NAMES[$i]}"; menu_scan "$i" 1 ;; *) menu_bad "$CHOICE" ;; esac; continue ;;
      s) if [ "$GS_STATUS" = ok ]; then menu_sync "$i" "$i"; else menu_bad "$CHOICE"; fi; continue ;;
    esac
    if ! [[ "$CHOICE" =~ ^[0-9]+$ ]] || [ "$CHOICE" -lt 1 ] || [ "$CHOICE" -gt ${#branches[@]} ]; then menu_bad "$CHOICE"; continue; fi
    rc=0; menu_branch "$i" "${branches[$((CHOICE - 1))]}" || rc=$?
    if [ "$rc" -eq 2 ]; then return 2; fi
  done
}

# menu_projects: the list of projects.
menu_projects() {
  local i n w=0 rc=0
  for i in "${!GM_NAMES[@]}"; do if [ ${#GM_NAMES[$i]} -gt "$w" ]; then w=${#GM_NAMES[$i]}; fi; done
  if [ "$w" -gt 20 ]; then w=20; fi
  while :; do
    echo ""
    echo "Projekte"
    for i in "${!GM_NAMES[@]}"; do
      n=${GM_NAMES[$i]}
      if [ ${#n} -gt 20 ]; then n="${n:0:19}…"; fi
      printf '%2s %s%*s  %s\n' "$((i + 1))" "$n" "$((w - ${#n}))" "" "${GM_SUMS[$i]}"
    done
    echo " ↑ pushen  ↓ holen  ! offen"
    echo " a alle synchronisieren"
    echo " f neu abrufen (fetch)"
    echo " q Ende"
    menu_read || return 0
    case "$CHOICE" in
      "") continue ;;
      q) return 0 ;;
      a) menu_sync 0 $((${#GM_NAMES[@]} - 1)); continue ;;
      f) menu_fetch_all 1; continue ;;
    esac
    if ! [[ "$CHOICE" =~ ^[0-9]+$ ]] || [ "$CHOICE" -lt 1 ] || [ "$CHOICE" -gt ${#GM_NAMES[@]} ]; then menu_bad "$CHOICE"; continue; fi
    rc=0; menu_project $((CHOICE - 1)) || rc=$?
    if [ "$rc" -eq 2 ]; then return 0; fi
  done
}

cmd_git() {
  GIT_MODE=status
  GIT_N_PUSH=0; GIT_N_FF=0; GIT_N_OPEN=0; GIT_N_FAIL=0; GIT_N_PLAN=0; GIT_STAR=0
  local fetch=1 list=0 menu=0
  if [ "${1-}" = sync ]; then GIT_MODE=sync; shift; fi
  local -a want=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-fetch) fetch=0 ;;
      --list) list=1 ;;
      --menu) menu=1 ;;
      -*) die "Unbekannte Option: $1" ;;
      *) want+=("$1") ;;
    esac
    shift
  done
  if [ "$GIT_MODE" = sync ] && [ "$fetch" -eq 0 ]; then die "--no-fetch gibt es nur für die Übersicht und das Menü, nicht für sync."; fi
  if [ "$GIT_MODE" = sync ] && [ $((list + menu)) -gt 0 ]; then die "--list und --menu gibt es nicht für sync."; fi
  if [ "$list" -eq 1 ] && [ "$menu" -eq 1 ]; then die "--list und --menu schließen sich aus."; fi
  # In a terminal `crb git` is the menu; shortcuts, cron and pipes get the overview.
  if [ "$GIT_MODE" = status ] && [ "$list" -eq 0 ] && [ -t 0 ] && [ -t 1 ]; then menu=1; fi

  # No Docker needed here, so not check_host.
  if [ "$(id -u)" -eq 0 ]; then die "Bitte nicht als root ausführen: Dateien im Repository gehören sonst root."; fi
  command -v git >/dev/null 2>&1 || die "git ist nicht installiert."
  [ -f compose.yaml ] || die "Hier liegt keine compose.yaml. Bitte im Ordner der Installation ausführen."
  if [ ! -f box.yaml ] || [ ! -d services ]; then
    die "crb git braucht das services/-Layout (box.yaml und services/<name>.yaml). Diese Installation führt ihre Services in compose.yaml."
  fi

  # Parallel arrays (bash 3.2 has no associative arrays).
  local -a names=() srcs=()
  local f n src i w found
  for f in services/*.yaml; do
    [ -f "$f" ] || continue
    n=$(basename "$f" .yaml)
    [ "$n" = crb-dashboard ] && continue
    src=$(service_workspace "$f")
    [ -n "$src" ] || continue
    names+=("$n"); srcs+=("$src")
  done
  [ ${#names[@]} -gt 0 ] || die "Keine Projekte in services/ gefunden."
  if [ ${#want[@]} -gt 0 ]; then
    for w in "${want[@]}"; do
      found=0
      for n in "${names[@]}"; do if [ "$n" = "$w" ]; then found=1; fi; done
      [ "$found" -eq 1 ] || die "Unbekanntes Projekt: $w (vorhanden: ${names[*]})"
    done
  fi

  # Never let Git wait for input: a remote that needs a passphrase, a password
  # or a host-key confirmation counts as a failed fetch or push.
  export GIT_TERMINAL_PROMPT=0
  export GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh -o BatchMode=yes -o ConnectTimeout=10}"
  # Reading must not write to a repository, not even the index.
  export GIT_OPTIONAL_LOCKS=0
  export GIT_EDITOR=true

  # The selected projects, in the order of services/.
  GM_NAMES=(); GM_SRCS=(); GM_SUMS=(); GM_FAILED=(); GM_MSGS=()
  for i in "${!names[@]}"; do
    if [ ${#want[@]} -gt 0 ]; then
      found=0
      for w in "${want[@]}"; do if [ "$w" = "${names[$i]}" ]; then found=1; fi; done
      [ "$found" -eq 1 ] || continue
    fi
    GM_NAMES+=("${names[$i]}"); GM_SRCS+=("${srcs[$i]}"); GM_SUMS+=(""); GM_FAILED+=(0); GM_MSGS+=("")
  done

  if [ "$menu" -eq 1 ]; then
    local rc=0
    menu_fetch_all "$fetch"
    # One project named: start at its branches.
    if [ ${#want[@]} -eq 1 ]; then menu_project 0 || rc=$?; fi
    if [ "$rc" -ne 2 ]; then menu_projects; fi
    return 0
  fi

  for i in "${!GM_NAMES[@]}"; do
    if [ "$i" -gt 0 ]; then echo ""; fi
    git_scan "${GM_SRCS[$i]}" "$fetch"
    git_report "${GM_NAMES[$i]}" "$fetch"
  done

  echo ""
  if [ "$GIT_MODE" = sync ]; then
    local sum="$GIT_N_PUSH gepusht · $GIT_N_FF geholt · $GIT_N_OPEN offen"
    if [ "$GIT_N_FAIL" -gt 0 ]; then sum="$sum · $GIT_N_FAIL Fehler"; fi
    echo "$sum"
  else
    echo "↓ fast-forward  ↑ push  ! offen"
    if [ "$GIT_N_PLAN" -gt 0 ]; then echo "Ausführen: ./crb git sync"; fi
  fi
  if [ "$GIT_STAR" -eq 1 ]; then echo "* lokale Änderungen im Checkout"; fi
  if [ "$GIT_N_FAIL" -gt 0 ]; then exit 1; fi
}

# =============================================================================

main() {
  local cmd=${1-}
  if [ $# -gt 0 ]; then shift; fi
  case "$cmd" in
    add) cmd_add "$@" ;;
    update) cmd_update "$@" ;;
    dashboard) cmd_dashboard "$@" ;;
    git) cmd_git "$@" ;;
    *) usage >&2; exit 64 ;;
  esac
}

main "$@"
